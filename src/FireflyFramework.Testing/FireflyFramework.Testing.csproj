<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FireflyFramework.Testing</RootNamespace>
    <PackageId>FireflyFramework.Testing</PackageId>
    <Description>Spring Boot Test framework port: FireflyTestBase, FireflyTestClient, [DataTest], [ServiceTest], [WebTest], MockBean, AssertEventPublished, test slicing. Mirrors pyfly/testing.</Description>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FireflyFramework.Kernel/FireflyFramework.Kernel.csproj" />
    <ProjectReference Include="../FireflyFramework.Eda/FireflyFramework.Eda.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="xunit" />
  </ItemGroup>
</Project>
