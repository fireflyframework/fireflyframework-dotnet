<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FireflyFramework.Scheduling</RootNamespace>
    <PackageId>FireflyFramework.Scheduling</PackageId>
    <Description>Cron-based task scheduling: [Scheduled] (cron, fixedRate, fixedDelay), ITaskScheduler, ITaskExecutorPort. Mirrors Spring @Scheduled and pyfly/scheduling. Uses Cronos for cron parsing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FireflyFramework.Kernel/FireflyFramework.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Cronos" />
  </ItemGroup>
</Project>
