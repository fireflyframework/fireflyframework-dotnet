{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Firefly": {
    "Web": {
      "ErrorHandling": { "IncludeStackTrace": false, "MaskPii": true },
      "Idempotency": { "Enabled": true, "HeaderName": "X-Idempotency-Key", "Ttl": "01:00:00" },
      "PiiMasking": { "Enabled": true }
    },
    "Cache": { "Provider": "Memory", "Name": "default" },
    "Eda": { "DefaultPublisher": "InMemory", "DefaultConsumer": "InMemory" },
    "Observability": {
      "Metrics": { "Enabled": true, "Prefix": "firefly", "Exporter": "Prometheus" },
      "Tracing": { "Enabled": true, "SamplingProbability": 0.1 }
    }
  }
}
